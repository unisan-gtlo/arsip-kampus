# Django
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=False
ALLOWED_HOSTS=arsip.unisan-g.id
SECURE_SSL_REDIRECT=True

# Database (Postgres)
DB_NAME=arsip
DB_USER=arsip
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Documents are stored on local disk (Docker volume `media`), NOT Google
# Drive - service accounts can't upload into personal Gmail-owned Drive
# storage. The GCP_*/SPREADSHEET_ID fields below are ONLY needed if you
# run the one-time `import_legacy_sheets` management command to migrate
# data from the old Streamlit app's Google Sheet.
# NOTE: GCP_PRIVATE_KEY must keep its \n line breaks literal (do not paste real newlines).
GCP_TYPE=service_account
GCP_PROJECT_ID=
GCP_PRIVATE_KEY_ID=
GCP_PRIVATE_KEY=
GCP_CLIENT_EMAIL=
GCP_CLIENT_ID=
GCP_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCP_TOKEN_URI=https://oauth2.googleapis.com/token
SPREADSHEET_ID=

MAX_UPLOAD_SIZE_MB=20

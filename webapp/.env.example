# Django
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=False
ALLOWED_HOSTS=arsip.unisna-g.id
SECURE_SSL_REDIRECT=True

# Database (Postgres)
DB_NAME=arsip
DB_USER=arsip
